# HappyGrandma Platform — .env.example
# Copy to .env and fill in values

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=happygrandma

# ── Directus (CMS) ─────────────────────────────────────────────────────────
DIRECTUS_ADMIN_EMAIL=admin@happygrandma.local
DIRECTUS_ADMIN_PASSWORD=admin
DIRECTUS_SECRET=change-this-in-production

# ── Application ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
OPENROUTER_API_KEY=sk-or-...
SESSION_SECRET=change-this-in-production
JWT_SECRET=change-this-in-production

# ── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3100
NEXT_PUBLIC_WS_URL=ws://localhost:3100

# ── Timezone ───────────────────────────────────────────────────────────────
TIMEZONE=Australia/Sydney
