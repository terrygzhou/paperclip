# Build stage
FROM node:20-alpine AS build

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy workspace manifests
COPY package.json pnpm-workspace.yaml ./
COPY packages/*/package.json ./packages/*/
COPY ui/package.json ./ui/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source
COPY packages/*/tsconfig.json ./packages/*/
COPY packages/*/src ./packages/*/src/
COPY ui/tsconfig.json ./ui/
COPY ui/src ./ui/src/
COPY ui/public ./ui/public/

# Build
ARG NEXT_PUBLIC_API_URL=http://localhost:3100
ARG NEXT_PUBLIC_WS_URL=ws://localhost:3100
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL

RUN pnpm --filter @happygrandma/ui build

# ── Production stage ──────────────────────────────────────────────────────
FROM node:20-alpine AS runtime

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy built app
COPY --from=build /app/ui/.next ./.next
COPY --from=build /app/ui/public ./ui/public
COPY --from=build /app/packages/db/dist ./packages/db/dist/

# Copy package.json files
COPY ui/package.json ./ui/
COPY packages/*/package.json ./packages/*/

# Install production deps only
RUN pnpm install --prod --frozen-lockfile

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

CMD ["node", "ui/.next/standalone/server.js"]
